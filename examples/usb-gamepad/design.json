 "notes": [
  {"sch": [152.4, 187.96], "text": "Power flags: the supply comes in through the cable"},
  {"sch": [25.4, 27.94], "text": "USB-C receptacle (USB 2.0): R8/R9 5.1 k on CC request 5 V; D1 clamps ESD on the data lines, F1 limits a short"},
  {"sch": [25.4, 106.68], "text": "Supply decoupling: 1 uF at each VCC/AVCC pair and UCAP (one part value, 5 uF in total, below the USB limit of 10 uF)"},
  {"sch": [119.38, 144.78], "text": "16 MHz crystal, load 18 pF: C1 = C2 = 2 x (18 pF - 5 pF stray) ~ 22 pF"},
  {"sch": [25.4, 144.78], "text": "Reset button and HWB pull-down: reset with HWB low starts the USB bootloader"},
  {"sch": [256.54, 30.48], "text": "Buttons switch to GND; the MCU's internal pull-ups hold them high"},
  {"sch": [256.54, 144.78], "text": "Status LEDs, 1 k each: (5 V - 2 V) / 1 k = 3 mA"},
  {"sch": [180.34, 213.36], "text": "Test points on the bottom, named on the silkscreen"}
